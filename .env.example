# MTS AI Workspace — Environment Variables
# ==========================================
# Скопируйте: cp .env.example .env
# Заполните MWS_API_KEY и POSTGRES_PASSWORD

# MWS GPT API Key (ОБЯЗАТЕЛЬНО)
MWS_API_KEY=your-api-key-here

# WebUI Secret Key (для JWT токенов)
WEBUI_SECRET_KEY=change-me-to-random-string

# Авторизация (admin@mts-ai.local / adminpassword123)
WEBUI_AUTH=true

# PostgreSQL
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=change-me-to-strong-password
POSTGRES_DB=openwebui

# Порты (менять при конфликтах)
# WEBUI_PORT=8080
# DB_PORT=5432
# SEARXNG_PORT=8888
# WHISPER_PORT=9000
# PORTAINER_PORT=9010
# DOZZLE_PORT=9990
