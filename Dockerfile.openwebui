# Базируемся на готовом образе OpenWebUI — без пересборки frontend
FROM ghcr.io/open-webui/open-webui:main

# Fix upstream bug: uncomment `db = None` to prevent UnboundLocalError in db.py
RUN sed -i 's/# db = None/db = None/' /app/backend/open_webui/internal/db.py

# Копируем кастомную тему (будет доступна по /static/custom.css)
COPY themes/custom.css /app/build/static/custom.css

# Копируем JS-виджет переключателя тем
COPY themes/theme-selector.js /app/build/static/theme-selector.js

# Копируем JS-виджет авторутинга
COPY themes/autorouting-selector.js /app/build/static/autorouting-selector.js

# Копируем JS-виджет категорий моделей
COPY themes/model-tags.js /app/build/static/model-tags.js

# Копируем JS-виджет pill-ссылок для цитат из deep research
COPY themes/citation-pills.js /app/build/static/citation-pills.js

# Инжектим скрипты в <head> HTML
RUN sed -i 's|</head>|<script>var t=localStorage.getItem("mts-theme");if(t)document.documentElement.setAttribute("data-theme",t);</script><script defer src="/static/theme-selector.js"></script><script defer src="/static/autorouting-selector.js"></script><script src="/static/model-tags.js"></script><script defer src="/static/citation-pills.js"></script></head>|' /app/build/index.html
