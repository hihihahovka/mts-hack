# Stage 1: Pre-built frontend from GitHub Container Registry
FROM ghcr.io/hihihahovka/mts-hack/open-webui:arseny-test AS build

# Stage 2: Inject it into the vanilla OpenWebUI Python backend
FROM ghcr.io/open-webui/open-webui:main

# Fix upstream bug: uncomment `db = None` to prevent UnboundLocalError in db.py
RUN sed -i 's/# db = None/db = None/' /app/backend/open_webui/internal/db.py

# Replace frontend with our fully custom-built version cleanly
RUN rm -rf /app/build/*
COPY --from=build /app/build /app/build

# Копируем кастомную тему (будет доступна по /static/custom.css)
COPY themes/custom.css /app/build/static/custom.css

# Voice Chat: inject script to intercept voice mode button
# Copy the inject script into the static directory
COPY services/voice_chat/static/inject.js /app/build/static/inject.js
# Inject <script> tag before </html> (SvelteKit build has no </body>)
RUN sed -i 's|</html>|<script src="/static/inject.js"></script></html>|g' /app/build/index.html

# Заменяем логотип OpenWebUI на логотип МТС
COPY themes/mts-logo.png /app/build/static/favicon.png
COPY themes/mts-logo.png /app/build/static/favicon-dark.png
COPY themes/mts-logo.png /app/build/static/splash.png
COPY themes/mts-logo.png /app/build/static/splash-dark.png

# Копируем фирменные шрифты МТС
COPY themes/fonts/mts/ /app/build/static/fonts/

# Копируем JS-виджет переключателя тем
COPY themes/theme-selector.js /app/build/static/theme-selector.js

# Копируем JS-виджет авторутинга
COPY themes/autorouting-selector.js /app/build/static/autorouting-selector.js

# Копируем JS-виджет категорий моделей
COPY themes/model-tags.js /app/build/static/model-tags.js

# Копируем JS-виджет цитат (citation pills)
COPY themes/citation-pills.js /app/build/static/citation-pills.js

# Инжектим скрипты МТС в <head> HTML
# NOTE: use '#' as sed delimiter because JS contains '||' which breaks '|' delimiter
RUN sed -i 's#</head>#<script>var t=localStorage.getItem("mts-theme")||"mts-dark";document.documentElement.setAttribute("data-theme",t);</script><link rel="stylesheet" href="/static/custom.css"><script defer src="/static/theme-selector.js"></script><script defer src="/static/autorouting-selector.js"></script><script src="/static/model-tags.js"></script><script defer src="/static/citation-pills.js"></script></head>#' /app/build/index.html

# Инжектим скрипт переключателя тем и авторутинга в <head> HTML
RUN sed -i 's|</head>|<script>var t=localStorage.getItem("mts-theme");if(t)document.documentElement.setAttribute("data-theme",t);</script><script defer src="/static/theme-selector.js"></script><script defer src="/static/autorouting-selector.js"></script><script src="/static/model-tags.js"></script></head>|' /app/build/index.html
